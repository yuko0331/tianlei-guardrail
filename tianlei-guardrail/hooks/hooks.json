{
  "description": "天磊安全围栏 Hook（PoC）",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/scripts/guard.mjs\" prompt", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/scripts/guard.mjs\" tool", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/scripts/guard.mjs\" toolResult", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/scripts/guard.mjs\" stop", "timeout": 10 }
        ]
      }
    ]
  }
}
